{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soup",
  "version": "0.1.0",
  "identifier": "com.incompl.soup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "soup",
        "width": 1100,
        "height": 750,
        "minWidth": 600,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["soup"],
        "name": "Soup Drawing",
        "description": "Soup drawing document",
        "role": "Editor",
        "mimeType": "application/x-soup"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
